# ── ~/.hermes/.env ────────────────────────────────────────────────
# Copy to ~/.hermes/.env on the machine running Hermes.
# NEVER commit the filled-in version. Secrets only — non-secret
# settings belong in config.yaml.

# ── Telegram gateway ──────────────────────────────────────────────
# Make a NEW bot via @BotFather. Do NOT reuse the LifePlanner bot
# token: two processes long-polling the same bot steal each other's
# messages and both appear broken.
TELEGRAM_BOT_TOKEN=

# Numeric user IDs allowed to talk to Hermes (from @userinfobot).
# Phase 0-4: just you. Phase 5: comma-separated, add your agents.
TELEGRAM_ALLOWED_USERS=

# Where scheduled results (the 8am brief) get pushed.
TELEGRAM_HOME_CHANNEL=

# ── LifePlanner bridge ────────────────────────────────────────────
# The Apps Script web app URL (same one in js/ai.js) and the token you
# set as BRIDGE_TOKEN in bridge/lifeplanner_bridge.gs.
LIFEPLANNER_BRIDGE_URL=https://script.google.com/macros/s/XXXXX/exec
LIFEPLANNER_BRIDGE_TOKEN=

# Your LifePlanner identity — the bridge scopes every query by this.
LIFEPLANNER_ADMIN_EMAIL=chongwei1986@gmail.com

# ── Phase 5: Telegram ID → LifePlanner email ──────────────────────
# JSON map so the bridge can scope each agent to their own book.
# LIFEPLANNER_USER_MAP={"123456789":"chongwei1986@gmail.com","987654321":"agent@example.com"}

# ── Model provider ────────────────────────────────────────────────
# Using Nous Portal OAuth (`hermes setup --portal`) means NO key here.
# Only needed if you later switch to OpenRouter or similar.
# OPENROUTER_API_KEY=
