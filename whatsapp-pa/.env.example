# ── JARVIS WhatsApp PA configuration ──────────────────────────────
# Copy to .env (or set these in your host's dashboard) and fill in.

# Create a NEW bot with @BotFather on Telegram (don't reuse the
# LifePlanner bot — that one uses a webhook, JARVIS uses polling).
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat ID (same one as in telegram_bot.gs).
TELEGRAM_CHAT_ID=

# Groq API key (free) — same one used by the LifePlanner AI Assistant.
GROQ_API_KEY=

# ── CRM lookup (optional but recommended) ─────────────────────────
# Lets JARVIS recognise clients by phone number and answer questions
# about THEIR actual AIA plans/cases using your LifePlanner CRM data.
# CRM_PROXY_URL = your Apps Script web app URL (same one as the
# Telegram bot / AI proxy, ending in /exec).
# CRM_PROXY_SECRET = any long random string; must match PA_SECRET
# in telegram_bot.gs.
CRM_PROXY_URL=
CRM_PROXY_SECRET=

# ── Optional ──────────────────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# OWNER_NAME=Keith
# OWNER_ROLE=an AIA Life Planner (insurance agent) in Malaysia serving clients in English, Malay and Chinese
# WATCH_GROUPS=false
# MAX_MESSAGE_AGE_SEC=120
# AUTH_DIR=./auth
# PORT=8080
